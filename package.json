{
  "name": "cnc-design-generator",
  "version": "1.0.3",
  "description": "Desktop CAD/CNC Engineering Application with AI Assistance",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "dev:electron": "electron electron/main.cjs",
    "dev": "concurrently -n vite,electron -c cyan,magenta \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "electron:dev": "npm run dev",
    "build:vite": "tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build": "npm run build:vite",
    "dist:win": "npm run build:vite && electron-builder --win nsis",
    "py:backend": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "test:api": ".venv\\Scripts\\python.exe scripts/e2e_api_test.py",
    "test:api:enhanced": ".venv\\Scripts\\python.exe tests/test_api_enhanced.py",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@react-three/drei": "^9.121.5",
    "@react-three/fiber": "^8.17.14",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.8.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.477.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.antidesign.desktop",
    "productName": "Anti Design",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/anti-design-logo.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "anti-design-platform",
      "repo": "frontend",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anti Design"
    }
  }
}
